# Kopiraj u .env (ili .env.local) i popuni. Ni jedan se NE commituje.

# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# ID modela sa https://openrouter.ai/models (filter: image input + structured_outputs)
# Primer formata: <provider>/<model-name>
MODEL_PRIMARY=google/gemini-2.5-flash
# Opciono: OpenRouter prelazi na ovaj model ako primarni nije dostupan
MODEL_FALLBACK=google/gemini-2.5-flash-lite

# v6: trenutni produkcioni prompt; starije verzije ostaju za eval uporedbu
PROMPT_VERSION=v6
# Ukupno (timeout × 2 pokušaja) mora da stane u maxDuration rute (30 s)
OPENROUTER_TIMEOUT_MS=12000
